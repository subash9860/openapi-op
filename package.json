{
  "name": "openapi-op",
  "version": "0.2.4",
  "description": "Typed API client generated from an OpenAPI spec — one op() per operation, no runtime validation, no codegen'd fetch soup.",
  "keywords": [
    "openapi",
    "swagger",
    "typescript",
    "codegen",
    "fetch",
    "api-client",
    "fastapi"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subash9860/openapi-op.git"
  },
  "homepage": "https://github.com/subash9860/openapi-op#readme",
  "bugs": "https://github.com/subash9860/openapi-op/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generator": "./generator.mjs"
  },
  "bin": {
    "openapi-op": "bin/openapi-op.mjs"
  },
  "files": [
    "dist",
    "bin",
    "generator.mjs",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "release": "npm version patch && git push --follow-tags",
    "version": "node scripts/changelog.mjs && git add CHANGELOG.md",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "openapi-typescript": "^7.13.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
